# Multi-stage non-root container for ratchet-authority
FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/ratchet-authority ./cmd/ratchet-authority

FROM alpine:3.21
RUN adduser -D -u 10001 ratchet
USER ratchet
WORKDIR /home/ratchet
COPY --from=builder /bin/ratchet-authority /usr/local/bin/ratchet-authority
EXPOSE 8086
ENTRYPOINT ["/usr/local/bin/ratchet-authority", "-port=8086"]
