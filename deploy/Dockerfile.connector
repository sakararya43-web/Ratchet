# Multi-stage non-root container for ratchet-connector
FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/ratchet-connector ./cmd/ratchet-connector

FROM alpine:3.21
RUN adduser -D -u 10001 ratchet
USER ratchet
WORKDIR /home/ratchet
COPY --from=builder /bin/ratchet-connector /usr/local/bin/ratchet-connector
ENTRYPOINT ["/usr/local/bin/ratchet-connector"]
