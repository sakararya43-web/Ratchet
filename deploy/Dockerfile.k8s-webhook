# Multi-stage non-root container for ratchet-k8s-webhook
FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/ratchet-k8s-webhook ./cmd/ratchet-k8s-webhook

FROM alpine:3.21
RUN adduser -D -u 10001 ratchet
USER ratchet
WORKDIR /home/ratchet
COPY --from=builder /bin/ratchet-k8s-webhook /usr/local/bin/ratchet-k8s-webhook
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/ratchet-k8s-webhook", "-port=8443"]
